{
    "name": "internetguru/laravel-images",
    "description": "Signed, resized and cached images for Laravel applications",
    "type": "library",
    "license": "CC-BY-NC-SA-4.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "InternetGuru\\LaravelImages\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Internet Guru",
            "email": "info@internetguru.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0",
        "intervention/image-laravel": "^4.1"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "InternetGuru\\LaravelImages\\ImagesServiceProvider"
            ]
        }
    }
}
